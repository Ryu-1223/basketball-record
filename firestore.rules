rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(team) {
      return request.auth != null &&
        request.auth.token.teamId == team &&
        exists(/databases/$(database)/documents/teams/$(team)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teams/$(team)/members/$(request.auth.uid)).data.enabled == true;
    }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optionalText(value, max) { return value is string && value.size() <= max; }
    function validSheetTeam(t) {
      return t is map && t.keys().hasOnly(['name', 'players', 'coach', 'assistant', 'coachLicense', 'assistantLicense', 'checked']) &&
        optionalText(t.name, 80) && t.players is list && t.players.size() <= 40 &&
        optionalText(t.coach, 40) && optionalText(t.assistant, 40) && optionalText(t.coachLicense, 3) && optionalText(t.assistantLicense, 3) &&
        t.checked.keys().hasOnly(['roster', 'entry', 'fouls', 'timeouts', 'score']) &&
        t.checked.roster is bool && t.checked.entry is bool && t.checked.fouls is bool && t.checked.timeouts is bool && t.checked.score is bool;
    }
    function validSheet(s) {
      return s is map && s.keys().hasOnly(['version', 'ownSide', 'competition', 'gameNo', 'venue', 'startTime', 'endTime', 'quarterMinutes', 'overtimeMinutes', 'officials', 'own', 'opponent']) &&
        s.version == 1 && s.ownSide in ['A', 'B'] && optionalText(s.competition, 80) && optionalText(s.gameNo, 80) && optionalText(s.venue, 80) && optionalText(s.startTime, 5) && optionalText(s.endTime, 5) &&
        s.quarterMinutes is int && s.quarterMinutes >= 1 && s.quarterMinutes <= 60 && s.overtimeMinutes is int && s.overtimeMinutes >= 1 && s.overtimeMinutes <= 60 &&
        s.officials is map && s.officials.keys().hasOnly(['chief', 'umpire1', 'umpire2', 'scorer', 'assistantScorer', 'timer', 'shotClock']) &&
        validSheetTeam(s.own) && validSheetTeam(s.opponent);
    }
    function validPlayer(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'name', 'number', 'active']) &&
        d.id == id && text(d.name, 40) && d.number is string &&
        d.number.matches('([0-9]|[1-9][0-9]|00)') && d.active is bool;
    }
    function validGame(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'opponent', 'date', 'roster', 'status', 'quarters', 'createdAt', 'updatedAt', 'opponentTracking', 'sheet', 'kind', 'recordMode', 'recordChecked', 'opponentRoster', 'sessionId', 'archived']) &&
        (!('sheet' in d) || validSheet(d.sheet)) &&
        (!('opponentTracking' in d) || d.opponentTracking is bool) &&
        (!('recordChecked' in d) || d.recordChecked is map) && (!('kind' in d) || d.kind == 'scrimmage') && (!('recordMode' in d) || d.recordMode in ['scores','own','both']) && (!('opponentRoster' in d) || (d.opponentRoster is list && d.opponentRoster.size() <= 40)) && (!('sessionId' in d) || text(d.sessionId, 128)) && (!('archived' in d) || d.archived is bool) &&
        d.id == id && text(d.opponent, 80) && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        d.status in ['ready', 'running', 'interval', 'finished'] &&
        d.roster is list && d.roster.size() > 0 && d.roster.size() <= 40 &&
        d.quarters is list && d.quarters.size() <= 99 &&
        d.createdAt is number && d.updatedAt is number;
    }
    function validDetails(d, g) {
      let t = d.details;
      let seconds = ('sheet' in g ? (d.quarter > 4 ? g.sheet.overtimeMinutes : g.sheet.quarterMinutes) : (d.quarter > 4 ? 3 : 8)) * 60;
      return t is map && t.keys().hasOnly(['code', 'penalty', 'countsTeam', 'remainingSec', 'note']) &&
        (!('note' in t) || optionalText(t.note, 120)) &&
        (d.action == 'entry' ||
         (d.action == 'timeout' && d.playerId == '@team' && (t.remainingSec == null || (t.remainingSec is int && t.remainingSec >= 0 && t.remainingSec <= seconds))) ||
         (d.action == 'foul' && t.code in ['P','T','U','D','F','C','B','M','GD'] && t.penalty in ['', '1','2','3','c'] && t.countsTeam is bool &&
          (!(d.playerId in ['@coach','@assistant']) || t.countsTeam == false)));
    }
    function validPlay(team, game, id) {
      let d = request.resource.data;
      let g = get(/databases/$(database)/documents/teams/$(team)/games/$(game)).data;
      return d.keys().hasOnly(['id', 'gameId', 'quarter', 'elapsedMs', 'playerId', 'action', 'shot', 'createdAt', 'updatedAt', 'cancelled', 'side', 'details', 'order']) &&
        (!('side' in d) || (d.side == 'opponent' && d.action in ['made','miss','rebound','steal','foul','timeout','entry'] && (d.action in ['made','foul','timeout','entry'] || ('kind' in g && g.kind == 'scrimmage')) && (d.playerId.matches('([0-9]|[1-9][0-9]|00)') || (d.action == 'made' && d.playerId == '@unknown') || (d.action == 'timeout' && d.playerId == '@team') || (d.action == 'foul' && d.playerId in ['@coach','@assistant'])))) &&
        (!('order' in d) || (d.order is number && d.order > -1000000000000000 && d.order < 1000000000000000)) &&
        d.id == id && d.gameId == game && text(d.playerId, 128) &&
        d.quarter is int && d.quarter >= 1 && d.quarter <= g.quarters.size() + (d.action == 'foul' && g.status in ['ready','interval'] ? 1 : 0) &&
        d.elapsedMs is number && d.elapsedMs >= 0 &&
        ((d.action in ['made', 'miss'] && d.shot in ['2', '3', 'ft']) ||
         (d.action in ['rebound', 'steal'] && d.shot == null) ||
         (d.action in ['foul','timeout','entry'] && d.shot == null && validDetails(d, g))) &&
        d.cancelled is bool && d.createdAt is number && d.updatedAt is number;
    }
    match /teams/{team} {
      allow read: if member(team);
      allow update: if member(team) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && text(request.resource.data.name, 80);
      allow create, delete: if false;
      match /members/{uid} {
        allow read: if request.auth != null && request.auth.token.teamId == team && request.auth.uid == uid;
        allow write: if false;
      }
      match /players/{id} {
        allow read: if member(team);
        allow create, update: if member(team) && validPlayer(id);
        allow delete: if false;
      }
      match /games/{game} {
        allow read: if member(team);
        allow create: if member(team) && validGame(game);
        allow update: if member(team) && validGame(game) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.roster.size() >= resource.data.roster.size();
        allow delete: if false;
        match /plays/{id} {
          allow read: if member(team);
          allow create: if member(team) && validPlay(team, game, id);
          allow update: if member(team) && validPlay(team, game, id) && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }
      }
    }
  }
}
